---
layout: base.njk
title: Dave Hulbert - Blog tags
permalink: /blog/tag/
---
{% set tagList = collections.blogTags | default([]) %}
{% set tagLinkClasses = "inline-flex items-baseline gap-2 border-b border-stone-800 pb-1 text-sm text-stone-400 transition hover:border-orange-300 hover:text-orange-200" %}
{% set tagCountClasses = "text-[0.65rem] text-stone-600" %}
<main class="px-6 py-16 sm:px-10">
  <div class="mx-auto flex max-w-4xl flex-col gap-12">
    <header class="space-y-4">
      <a class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-orange-200" href="/blog/">
        <span aria-hidden="true">←</span>
        Back to blog
      </a>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-100">Browse every topic</h1>
      <p class="text-lg text-stone-400">
        Every tag used across the blog, listed alphabetically. Choose a tag to explore the posts that mention it.
      </p>
    </header>

    {% if tagList | length %}
    <section class="border-y border-stone-800 py-7">
      <ul class="flex flex-wrap gap-x-5 gap-y-3">
        {% for tag in tagList %}
        <li>
          <a class="{{ tagLinkClasses }}" href="{{ tag.permalink }}">
            {{ tag.name | lower }}
            <span class="{{ tagCountClasses }}">{{ tag.count }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% else %}
    <p class="text-base text-stone-500">No tags available yet.</p>
    {% endif %}
  </div>
</main>
