---
layout: base.njk
title: Dave Hulbert - Blog tags
permalink: /blog/tag/
---
{% set tagList = collections.blogTags | default([]) %}
{% set tagLinkClasses = "inline-flex items-center gap-2 rounded-full border border-stone-300 bg-stone-100 px-3 py-1 text-xs font-semibold tracking-wide text-stone-700 transition hover:border-stone-700 hover:text-stone-900" %}
{% set tagCountClasses = "rounded-full border border-stone-300 bg-stone-50 px-2 py-0.5 text-[0.65rem] font-medium text-stone-500" %}
<main class="px-6 py-16 sm:px-10">
  <div class="mx-auto flex max-w-4xl flex-col gap-12">
    <header class="space-y-4">
      <a class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 hover:text-stone-900" href="/blog/">
        <span aria-hidden="true">←</span>
        Back to blog
      </a>
      <p class="eyebrow">Tags</p>
      <h1 class="text-4xl font-semibold tracking-tight text-stone-900">Browse every topic</h1>
      <p class="text-lg text-stone-600">
        Every tag used across the blog, listed alphabetically. Choose a tag to explore the posts that mention it.
      </p>
    </header>

    {% if tagList | length %}
    <section class="rounded-3xl border border-stone-300 bg-stone-50">
      <ul class="flex flex-wrap gap-2 px-6 py-8 sm:px-8">
        {% for tag in tagList %}
        <li>
          <a class="{{ tagLinkClasses }}" href="{{ tag.permalink }}">
            {{ tag.name | lower }}
            <span class="{{ tagCountClasses }}">{{ tag.count }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% else %}
    <p class="text-base text-stone-500">No tags available yet.</p>
    {% endif %}
  </div>
</main>
