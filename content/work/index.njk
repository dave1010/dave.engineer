---
layout: base.njk
title: Work - Dave Hulbert
---
{% from "components/work-card.njk" import renderWorkCard %}
{% set featuredItems = [] %}
{% set otherItems = [] %}
{% for item in collections.workItems %}
  {% if item.data.featured %}
    {% set featuredItems = featuredItems.concat([item]) %}
  {% else %}
    {% set otherItems = otherItems.concat([item]) %}
  {% endif %}
{% endfor %}
<main class="px-6 py-16 sm:px-10">
  <div class="mx-auto flex max-w-5xl flex-col gap-16">
    <header class="max-w-3xl space-y-6">
      <a
        class="inline-flex items-center gap-2 text-sm text-stone-500 transition hover:text-orange-200"
        href="/"
      >
        <span aria-hidden="true">←</span>
        Back to home
      </a>
      <div class="space-y-4">
        <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-100">Selected work</h1>
        <p class="text-lg text-stone-400">
          Tools, experiments and open-source projects I've built or contributed to.
        </p>
      </div>
    </header>

    {% if featuredItems | length %}
    <section class="space-y-6">
      <h2 class="font-serif text-2xl font-semibold tracking-tight text-stone-100">Featured</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {% for item in featuredItems %}
          {{ renderWorkCard(item, {
            variant: "standard",
            primaryLabel: "Learn more",
            websiteLabel: "Visit site",
            githubLabel: "View source",
            articleClasses: "flex h-full flex-col justify-between gap-4 border-t border-stone-700 pt-5",
            titleClasses: "font-serif text-xl font-semibold text-stone-100",
            titleLinkClasses: "transition hover:text-orange-200",
            ctaContainerClasses: "flex flex-wrap gap-3 text-sm"
          }) | safe }}
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if otherItems | length %}
    <section class="space-y-6">
      <h2 class="font-serif text-2xl font-semibold tracking-tight text-stone-100">More work</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in otherItems %}
          {{ renderWorkCard(item, {
            variant: "standard",
            primaryLabel: "Learn more",
            websiteLabel: "Visit site",
            githubLabel: "View source"
          }) | safe }}
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </div>
</main>
