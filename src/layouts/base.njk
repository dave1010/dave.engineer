<!DOCTYPE html>
<html lang="en" class="h-full bg-stone-950">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "" }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@500;600&display=swap"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="Dave Hulbert - Blog" href="/feed.xml">
  {% if headExtra %}
    {{ headExtra | safe }}
  {% endif %}
</head>
<body class="min-h-screen">
  <div class="flex min-h-screen flex-col">
    <header class="mx-auto flex w-full max-w-6xl flex-col items-start gap-4 border-b border-stone-800 px-6 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-10">
      <a href="/" class="font-serif text-lg font-semibold text-stone-100 transition hover:text-orange-300">
        dave.engineer
      </a>
      {% if navigation and navigation | length %}
      <nav class="flex flex-wrap items-center gap-5 text-sm text-stone-400">
        {% for link in navigation %}
        <a class="hover:text-stone-100" href="{{ link.href }}">{{ link.label }}</a>
        {% endfor %}
      </nav>
      {% endif %}
    </header>
    <div class="flex-1">
      {{ content | safe }}
    </div>
    <footer class="border-t border-stone-800">
      <div class="mx-auto flex max-w-6xl flex-col gap-5 px-6 py-8 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between sm:px-10">
        <nav class="flex flex-wrap items-center gap-5 text-sm text-stone-400">
          <a class="hover:text-stone-100" href="/">dave.engineer</a>
          {% if navigation and navigation | length %}
            {% for link in navigation %}
            <a class="hover:text-stone-100" href="{{ link.href }}">{{ link.label }}</a>
            {% endfor %}
          {% endif %}
        </nav>
        <p class="text-xs">© Dave Hulbert</p>
      </div>
    </footer>
  </div>
  {% if scripts %}
    {{ scripts | safe }}
  {% endif %}
  <script type="module" src="/js/site.js"></script>
</body>
</html>
