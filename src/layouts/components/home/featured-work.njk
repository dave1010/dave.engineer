{% from "components/work-card.njk" import renderWorkCard %}

{% macro renderFeaturedWorkSection(items, config) %}
  {% set featuredItems = [] %}
  {% for item in items %}
    {% if item.data.featured %}
      {% set featuredItems = featuredItems.concat([item]) %}
    {% endif %}
  {% endfor %}
  {% if featuredItems | length %}
  <section class="space-y-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        {% if config.sectionTitle %}
        <h2 class="section-heading">{{ config.sectionTitle }}</h2>
        {% endif %}
      </div>
      {% if config.viewAllHref and config.viewAllLabel %}
      <a
        class="text-link"
        href="{{ config.viewAllHref }}"
      >
        {{ config.viewAllLabel }}
        <span aria-hidden="true">→</span>
      </a>
      {% endif %}
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {% for item in featuredItems %}
        {{
          renderWorkCard(item, {
            variant: "featured",
            defaultRole: config.defaultRole,
            primaryLabel: config.primaryCtaLabel or "Case file",
            websiteLabel: config.websiteLabel or "Live site",
            githubLabel: config.githubLabel or "Source"
          })
          | safe
        }}
      {% endfor %}
    </div>
  </section>
  {% endif %}
{% endmacro %}
