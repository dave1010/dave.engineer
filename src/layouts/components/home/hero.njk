{% macro renderHomeHero(hero) %}
  <section class="paper-card">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_0.7fr]">
      <div class="space-y-8">
        {% if hero.badgeLabel %}
        <p class="eyebrow">{{ hero.badgeLabel }}</p>
        {% endif %}
        {% if hero.name %}
        <h1 class="text-balance text-5xl font-semibold leading-[1.05] text-stone-900 sm:text-6xl">
          {{ hero.name }}
        </h1>
        {% endif %}
        {% if hero.subtitle %}
        <p class="max-w-2xl text-xl text-stone-600">{{ hero.subtitle }}</p>
        {% endif %}
        {% if hero.paragraphs and hero.paragraphs | length %}
        <div class="max-w-2xl space-y-5 text-lg leading-relaxed text-stone-700">
          {% for paragraph in hero.paragraphs %}
          <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
        {% endif %}
        {% if hero.ctas and hero.ctas | length %}
        <div class="flex flex-wrap items-center gap-3">
          {% for cta in hero.ctas %}
          <a class="link-pill" href="{{ cta.href }}">
            {{ cta.label }}
            {% if cta.trailingIcon %}<span aria-hidden="true">{{ cta.trailingIcon }}</span>{% endif %}
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <aside class="paper-card bg-stone-100 p-6 sm:p-8">
        <img
          src="/img/dave.jpg"
          alt="Dave Hulbert"
          width="220"
          height="220"
          class="mx-auto h-48 w-48 rounded-full border border-stone-300 object-cover"
          loading="lazy"
        >
        <blockquote class="mt-8 border-l-2 border-stone-300 pl-4 text-sm leading-relaxed text-stone-700">
          Building thoughtful systems, practical strategy, and resilient engineering cultures.
        </blockquote>
      </aside>
    </div>
  </section>
{% endmacro %}
