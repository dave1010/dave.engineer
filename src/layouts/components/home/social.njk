{% macro renderSocialSection(config, links) %}
  {% if links and links | length %}
  <section class="paper-card space-y-6">
      {% if config.sectionLabel %}
      <p class="eyebrow">{{ config.sectionLabel }}</p>
      {% endif %}
      {% if config.sectionTitle %}
      <h2 class="section-title">{{ config.sectionTitle }}</h2>
      {% endif %}
      <div class="grid gap-4 sm:grid-cols-2">
        {% for link in links %}
        <a
          href="{{ link.href }}"
          target="_blank"
          rel="noopener"
          class="rounded-2xl border border-stone-300 bg-stone-100 p-5 transition hover:border-stone-700"
        >
          <h3 class="text-lg font-semibold text-stone-900">{{ link.label }}</h3>
        </a>
        {% endfor %}
      </div>
  </section>
  {% endif %}
{% endmacro %}
