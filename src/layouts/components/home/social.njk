{% macro renderSocialSection(config, links) %}
  {% if links and links | length %}
  <section class="border-y border-stone-800 py-12">
    <div class="space-y-6">
      {% if config.sectionTitle %}
      <h2 class="section-heading">{{ config.sectionTitle }}</h2>
      {% endif %}
      <div class="grid border-t border-stone-800 sm:grid-cols-2">
        {% for link in links %}
        <a
          href="{{ link.href }}"
          target="_blank"
          rel="noopener"
          class="border-b border-stone-800 py-4 font-serif text-lg text-stone-200 transition hover:text-orange-200 sm:odd:pr-6 sm:even:border-l sm:even:pl-6"
        >
          {{ link.label }} <span aria-hidden="true" class="font-sans text-sm text-stone-600">↗</span>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
{% endmacro %}
