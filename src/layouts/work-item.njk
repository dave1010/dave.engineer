---
layout: base.njk
---
<main class="px-6 py-16 sm:px-10">
  <article class="mx-auto flex max-w-3xl flex-col gap-10">
    <header class="space-y-4">
      <a class="text-sm text-stone-500 hover:text-orange-200" href="/work/">← Work</a>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-100">{{ title }}</h1>
      {% if description %}
      <p class="text-lg text-stone-400">{{ description }}</p>
      {% endif %}
      {% if websiteUrl or githubUrl %}
      <div class="flex flex-wrap gap-3 text-sm">
        {% if websiteUrl %}
        <a
          class="text-link"
          href="{{ websiteUrl }}"
          target="_blank"
          rel="noopener"
        >
          Visit site
          <span aria-hidden="true">↗</span>
        </a>
        {% endif %}
        {% if githubUrl %}
        <a
          class="text-link"
          href="{{ githubUrl }}"
          target="_blank"
          rel="noopener"
        >
          View source
          <span aria-hidden="true">↗</span>
        </a>
        {% endif %}
      </div>
      {% endif %}
    </header>
    <div class="prose prose-invert prose-lg max-w-none">
      {{ content | safe }}
    </div>
  </article>
</main>
