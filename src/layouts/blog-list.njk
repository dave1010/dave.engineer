---
layout: base.njk
---
{% from "components/post-list.njk" import renderPostList %}
{% from "components/blog-meta.njk" import tagClasses, tagContainerClasses %}
{% set postsToRender = posts | default([]) %}
{% if (postsToRender | length) == 0 and collections.blog %}
  {% set postsToRender = collections.blog | reverse %}
{% endif %}
{% set typeGroups = collections.blogPostsByType | default([]) %}
{% set totalCount = 0 %}
{% for group in typeGroups %}
  {% set totalCount = totalCount + (group.count | default(group.items | length)) %}
{% endfor %}
{% set tagList = collections.blogTags | default([]) %}
{% set tagLinkClasses = tagClasses() %}
{% set tagCountClasses = "text-[0.65rem] text-stone-600" %}
{% set paginationButtonClasses = "inline-flex items-center gap-2 border-b border-stone-700 pb-1 text-sm text-stone-400 transition hover:border-orange-300 hover:text-orange-200" %}
{% set paginationActiveClasses = "border-orange-400 text-stone-100" %}
<main class="px-6 py-16 sm:px-10">
  <div class="mx-auto flex max-w-4xl flex-col gap-12">
    <header class="space-y-4">
      <a
        class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-orange-200"
        href="/"
      >
        <span aria-hidden="true">←</span>
        Back to home
      </a>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-100">{{ listTitle or "Writing" }}</h1>
      {% if listDescription %}
        <p class="text-lg text-stone-400">{{ listDescription }}</p>
      {% endif %}
    </header>

    {% if typeGroups | length %}
    <nav aria-label="Filter posts by type" class="flex flex-col gap-3">
      <p class="text-sm text-stone-500">Filter by type</p>
      <ul class="flex flex-wrap gap-2">
        <li>
          {% set isAllActive = not currentType %}
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 border-b pb-1 text-sm transition hover:border-orange-300 hover:text-orange-200 {{ "border-orange-400 text-stone-100" if isAllActive else "border-stone-800 text-stone-500" }}"
            {% if isAllActive %}aria-current="page"{% endif %}
          >
            All
            <span class="text-xs text-stone-600">{{ totalCount }}</span>
          </a>
        </li>
        {% for group in typeGroups %}
        <li>
          {% set isActive = currentType == group.type %}
          {% set badgeClasses = "" %}
          {% if group.type == "post" %}
            {% set badgeClasses = "border-orange-400 text-stone-100" %}
          {% elseif group.type == "til" %}
            {% set badgeClasses = "border-orange-400 text-stone-100" %}
          {% elseif group.type == "external" %}
            {% set badgeClasses = "border-orange-400 text-stone-100" %}
          {% endif %}
          <a
            href="{{ group.permalink }}"
            class="inline-flex items-center gap-2 border-b pb-1 text-sm transition hover:border-orange-300 hover:text-orange-200 {{ badgeClasses if isActive else "border-stone-800 text-stone-500" }}"
            {% if isActive %}aria-current="page"{% endif %}
          >
            {{ group.label }}
            <span class="text-xs text-stone-600">{{ group.count }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>
    {% endif %}

    {% if tagList | length %}
    {% set tagPreview = tagList.slice(0, 12) %}
    <section class="space-y-3">
      <div class="flex items-center justify-between gap-4">
        <p class="text-sm text-stone-500">Browse by tag</p>
        <a class="text-sm text-stone-400 transition hover:text-orange-200" href="/blog/tag/">View all tags →</a>
      </div>
      <div class="{{ tagContainerClasses() }}">
        {% for tag in tagPreview %}
        {% set isCurrentTag = currentTagSlug and currentTagSlug == tag.slug %}
        <a
          href="{{ tag.permalink }}"
          class="{{ tagLinkClasses }} {{ "text-orange-200" if isCurrentTag }}"
          {% if isCurrentTag %}aria-current="page"{% endif %}
        >
          {{ tag.name | lower }}
          <span class="{{ tagCountClasses }}">{{ tag.count }}</span>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if content | trim %}
      <div class="prose prose-invert max-w-none">{{ content | safe }}</div>
    {% endif %}

    {{ renderPostList(postsToRender, {
      tagLinkClasses: tagLinkClasses,
      showEmptyMessage: true,
      emptyMessage: "No posts found."
    }) | safe }}

    {% if listingPagination and listingPagination.totalPages > 1 %}
    <nav aria-label="Pagination" class="flex flex-col items-center gap-3 pt-6">
      <p class="text-sm text-stone-500">Page {{ listingPagination.currentPage }} of {{ listingPagination.totalPages }}</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {% if listingPagination.previous %}
        <a class="{{ paginationButtonClasses }}" href="{{ listingPagination.previous.url }}">
          <span aria-hidden="true">←</span>
          Newer posts
        </a>
        {% endif %}
        <ul class="flex flex-wrap items-center gap-2">
          {% for pageLink in listingPagination.pages %}
          <li>
            {% if pageLink.isCurrent %}
            <span class="{{ paginationButtonClasses }} {{ paginationActiveClasses }}" aria-current="page">{{ pageLink.number }}</span>
            {% else %}
            <a class="{{ paginationButtonClasses }}" href="{{ pageLink.url }}">{{ pageLink.number }}</a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% if listingPagination.next %}
        <a class="{{ paginationButtonClasses }}" href="{{ listingPagination.next.url }}">
          Older posts
          <span aria-hidden="true">→</span>
        </a>
        {% endif %}
      </div>
    </nav>
    {% endif %}
  </div>
</main>
